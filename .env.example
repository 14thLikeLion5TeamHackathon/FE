# API base URL (axios baseURL)
#
# ⚠️ 경로 규칙: API 함수의 경로에 `/api` 접두어가 들어간다 (예: axiosInstance.get('/api/users/me')).
#    그러니 이 값에는 **오리진만** 넣는다. `https://api.example.com/api` 처럼 넣으면 `/api/api/...`가 된다.
#
# - dev: 쿠키 세션이면 비워두고 vite.config.ts 프록시를 켠다(상대경로 → same-origin).
#        비워두면 MSW 목이 그대로 동작한다.
# - prod: https://api.example.com 처럼 오리진만 넣는다.
VITE_API_BASE_URL=

# ── dev 프록시 ─────────────────────────────────────────────
# 프록시 대상 오리진. VITE_API_BASE_URL을 비워두면 상대경로 요청이 이 서버로 전달된다.
# BE가 우리 dev 오리진을 CORS로 허용하지 않을 때 이걸로 우회한다.
VITE_API_PROXY_TARGET=

# ── 소셜 로그인 ────────────────────────────────────────────
# 로그인 시작 주소(BE 오리진). 비우면 VITE_API_PROXY_TARGET을 대신 쓴다.
#
# ⚠️ 둘 다 비어 있으면 로그인 버튼이 잠긴다 — 갈 곳이 없기 때문이다.
#    카카오 버튼은 비활성으로, 구글 버튼은 아예 숨겨진 상태로 보인다.
#
# 구글은 이 값이 IP 주소인 동안 버튼이 숨겨진다. 구글이 IP를 콜백으로 거부하기 때문이고,
# 서버에 도메인이 붙어 이 값만 바꾸면 코드 수정 없이 다시 노출된다.
VITE_OAUTH_ORIGIN=

# ── 외부 서비스 연동 (구글 캘린더 · 카카오 알림) ─────────────
# 소셜 "로그인"과 다르다. 로그인은 BE가 자기 키로 처리하지만, "연동"은 프론트가 직접
# 동의 화면을 열어 인가 코드를 받아 BE에 넘겨야 해서 FE용 키가 따로 필요하다.
#
# ⚠️ 비어 있으면 마이 탭의 연동 버튼이 감춰진다 — 키 없이 누르면 동의 화면 대신
#    제공자의 에러 페이지로 가기 때문이다.
#
# 콜백 주소는 코드가 만든다(lib/connect.ts의 CONNECT_PATH). 제공자 콘솔에 등록된 값과
# 글자 하나까지 같아야 하므로, 경로를 바꾸려면 콘솔 등록도 같이 고쳐야 한다.

# Google Cloud → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID(웹)
# 승인된 리디렉션 URI에 <오리진>/oauth/google 을 등록해 둘 것.
VITE_GOOGLE_CLIENT_ID=

# 카카오 developers → 앱 설정 → 플랫폼 키 → **REST API 키**
# JavaScript 키가 아니다 — 그건 JS SDK용이고, 우리는 리다이렉트 방식이라 REST 키를 쓴다.
# 리다이렉트 URI는 REST API 키 쪽 "로그인 리다이렉트 URI"에 등록한다.
VITE_KAKAO_REST_KEY=
